# Documentation generation rules for grove-project-tmpl-go

# Include all repository contents (template files)
*

# Include grove-meta source for understanding Grove ecosystem integration
../grove-meta/**/*.go

# Reference docs for tone and structure examples
../grove-flow/docs
../grove-context/docs

# Exclude files that would add noise to the context
!.grove-worktrees
!**/*_test.go
!vendor/**/*
!bin/**/*
!.git/**/*
!node_modules